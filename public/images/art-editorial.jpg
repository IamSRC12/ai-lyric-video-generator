<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">

  <defs>
    <linearGradient id="bgEdit" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#12141a"/>
      <stop offset="60%" stop-color="#1c202a"/>
      <stop offset="100%" stop-color="#0d0e12"/>
    </linearGradient>
    <radialGradient id="editLight" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#d8cfbe" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#12141a" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#bgEdit)"/>
  <circle cx="960" cy="450" r="550" fill="url(#editLight)"/>
  <circle cx="960" cy="540" r="320" fill="none" stroke="#d8cfbe" stroke-width="1" opacity="0.2"/>

